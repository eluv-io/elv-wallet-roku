import "pkg:/components/http/http.bs"
import "pkg:/components/stores/stores.bs"

namespace PropertyApi
    function baseUrl() as string
        return stores.fabricConfigStore()@.getAuthdBaseUrl()
    end function

    ' The categorized rows of the Discover page, and every Property they reference.
    function discover() as object
        url = `${baseUrl()}/mw/discover`
        return http.get(url)
    end function

    function ownedProperties() as object
        url = `${baseUrl()}/mw/properties?include_public=false`
        return http.get(url)
    end function

    function getPropertyById(propertyId)
        url = `${baseUrl()}/mw/properties/${propertyId}`
        return http.get(url)
    end function

    function getPageById(propertyId, pageId)
        url = `${baseUrl()}/mw/properties/${propertyId}/pages/${pageId}`
        return http.get(url)
    end function

    function sectionsById(propertyId, sectionIds)
        url = `${baseUrl()}/mw/properties/${propertyId}/sections?resolve_subsections=true`
        return http.post(url, formatJson(sectionIds))
    end function

    ' The primary/secondary filters a Property offers on its search screen.
    function getSearchFilters(propertyId as string) as object
        url = `${baseUrl()}/mw/properties/${propertyId}/filters`
        return http.get(url)
    end function

    ' [attributes] maps a filter attribute id to the selected values, e.g. { genre: ["Action"] }.
    function search(propertyId as string, query as string, attributes = invalid as object) as object
        url = `${baseUrl()}/mw/properties/${propertyId}/search`
        body = { search_term: query }
        if attributes <> invalid and attributes.count() > 0
            body.attributes = attributes
        end if
        return http.post(url, formatJson(body))
    end function

    function getMediaItems(propertyId as string, mediaItemIds) as object
        url = `${baseUrl()}/mw/properties/${propertyId}/media_items`
        return http.post(url, formatJson(mediaItemIds))
    end function
end namespace
