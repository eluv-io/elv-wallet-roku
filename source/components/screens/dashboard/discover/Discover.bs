import "pkg:/components/utils/NftOps.bs"
import "pkg:/components/utils/UrlUtil.bs"
import "pkg:/components/screens/signin/SignInUtil.bs"
import "pkg:/components/stores/stores.bs"
import "pkg:/components/utils/str.bs"

' Card art is 2:3. 1080p pixels are 2x Android's dp, so these are its 120x180dp cards.
const CARD_WIDTH = 240
const CARD_HEIGHT = 360
const CARD_SPACING = 20
' Gap between a row's title and its cards, and between one row and the next.
const ROW_TITLE_GAP = 50
const ROW_SPACING = 50
const ROW_TITLE_FONT = "28_medium"
' Keeps the first row's title clear of the top of the list.
const ROWS_TOP_PADDING = 36

' The hero sits at fixed positions rather than growing to fit: every Property reserves the
' same room for its logo and description, so the rows below never move as focus changes.
const LOGO_TOP = 160
const LOGO_HEIGHT = 180
const LOGO_MAX_WIDTH = 1000
const HERO_TEXT_FONT = "26_semibold"
const HERO_TEXT_LINES = 3
const HERO_TEXT_LINE_SPACING = 10
' Between the logo box and the description, and between the description and the rows.
const HERO_TEXT_TOP_GAP = 55
const HERO_TEXT_BOTTOM_GAP = 22

sub init()
    stores.propertyStore()@.fetchDiscover()

    m.root = m.top.findNode("root")
    m.logo = m.top.findNode("logo")
    m.logoText = m.top.findNode("logoText")
    m.heroDescription = m.top.findNode("heroDescription")
    m.bgImage = m.top.findNode("bgImage")
    m.scrims = m.top.findNode("scrims")
    m.rowsFade = m.top.findNode("rowsFade")

    layoutHero()

    rowList = m.top.findNode("rowList")
    m.rowList = rowList
    rowList.translation = [0, m.rowsTop + ROWS_TOP_PADDING]
    rowList.rowItemSize = [[CARD_WIDTH, CARD_HEIGHT]]
    rowList.rowItemSpacing = [[CARD_SPACING, 0]]
    rowList.rowSpacings = [ROW_SPACING]
    rowList.rowLabelOffset = [[0, ROW_TITLE_GAP]]
    m.rowTitleHeight = measureLine(ROW_TITLE_FONT)
    rowList.rowHeights = [m.rowTitleHeight + ROW_TITLE_GAP + CARD_HEIGHT]

    observe(rowList, "rowItemSelected", onPropertySelected)
    observe(rowList, "rowItemFocused", onPropertyFocused)
    observe(m.logo, "loadStatus", onLogoLoaded)

    observe(stores.propertyStore(), "discoverRows", onDiscoverRowsChanged)
end sub

' Places the logo and the description, and works out where that leaves the rows.
sub layoutHero()
    m.logo.translation = [0, LOGO_TOP]
    ' The name stands in for a missing logo, on the logo box's bottom edge.
    m.logoText.translation = [0, LOGO_TOP + LOGO_HEIGHT - measureLine("48_bold")]

    descriptionTop = LOGO_TOP + LOGO_HEIGHT + HERO_TEXT_TOP_GAP
    descriptionHeight = (measureLine(HERO_TEXT_FONT) * HERO_TEXT_LINES) + (HERO_TEXT_LINE_SPACING * (HERO_TEXT_LINES - 1))
    m.heroDescription.translation = [0, descriptionTop]
    m.heroDescription.height = descriptionHeight

    m.rowsTop = descriptionTop + descriptionHeight + HERO_TEXT_BOTTOM_GAP
end sub

' Height of a single line of text in [fontStyle].
function measureLine(fontStyle as string) as float
    label = createObject("roSGNode", "TvLabel")
    label.update({ fontStyle: fontStyle, text: "A" })
    return label.boundingRect().height
end function

sub initAfterParenting()
    m.top.getParent().observeFieldScoped("translation", "onParentTranslationChanged")
    onParentTranslationChanged()

    ' init with dummy cards that shimmer while we load real data
    if m.rowList.content = invalid
        content = CreateObject("roSGNode", "ContentNode")
        for i = 1 to 2
            row = newRow(content, "")
            for j = 1 to 8
                row.createChild("AAContentNode")
            end for
        end for
        setRowListContent(content)
    end if
end sub

sub onResume()
    onParentTranslationChanged()
end sub

sub onParentTranslationChanged()
    offset = m.top.getParent?()?.translation?[0] ?? 0
    padding = m.root.translation[0]

    ' Give the background and its scrims negative translation to make sure they start
    ' at the global x=0, even though the parent is translated to clear the side nav.
    m.bgImage.translation = [-offset, 0]
    m.scrims.translation = [-offset, 0]
    m.rowsFade.translation = [-offset, 1080 - m.rowsFade.height]

    rowWidth = 1920 - offset - padding
    rowsHeight = 1080 - m.rowList.translation[1]
    m.rowList.itemSize = [rowWidth, m.rowList.rowHeights[0]]
    ' Rows scroll up past the top of the list, keep them from drawing over the hero info.
    m.rowList.clippingRect = [0, 0, rowWidth, rowsHeight]
    m.rowList.itemClippingRect = { x: 0, y: 0, width: rowWidth, height: rowsHeight }
end sub

sub onDiscoverRowsChanged(event)
    rows = event.getData()
    if rows = invalid or rows.count() = 0 then return

    content = CreateObject("roSGNode", "ContentNode")
    for each row in rows
        rowNode = newRow(content, row.title)
        for each property in row.properties
            rowNode.createChild("AAContentNode").aa = property
        end for
    end for
    setRowListContent(content)

    ' Nothing is focused until the user moves, so preview the first Property meanwhile.
    showHeroInfo(rows[0].properties[0])
end sub

' Sizes every row before handing over the content: a row with no title reserves no room
' for one, so its cards sit where the title would have been.
sub setRowListContent(content)
    rowCount = content.getChildCount()
    rowHeights = CreateObject("roArray", rowCount, false)
    showRowLabel = CreateObject("roArray", rowCount, false)

    for i = 0 to rowCount - 1
        titled = content.getChild(i).title <> ""
        showRowLabel[i] = titled
        rowHeights[i] = titled ? m.rowTitleHeight + ROW_TITLE_GAP + CARD_HEIGHT : CARD_HEIGHT
    end for

    m.rowList.rowHeights = rowHeights
    m.rowList.showRowLabel = showRowLabel
    m.rowList.content = content
end sub

' [aa] is where TvLabel picks up the row title's font.
function newRow(content, title as string)
    row = content.createChild("AAContentNode")
    row.title = title
    row.aa = { fontStyle: ROW_TITLE_FONT }
    return row
end function

sub onPropertyFocused()
    showHeroInfo(propertyAt(m.rowList.rowItemFocused))
end sub

' Swaps the background, logo and description over to [property].
sub showHeroInfo(property)
    if property = invalid then return

    bgImageLink = property.image_tv ?? property.main_page?.layout?.background_image
    m.bgImage@.changeImage(UrlUtil.imageLinkToUrl(bgImageLink, m.bgImage.height))

    logoLink = property.tv_header_logo ?? property.header_logo
    logoUrl = UrlUtil.imageLinkToUrl(logoLink, LOGO_HEIGHT)
    m.logo.width = LOGO_MAX_WIDTH
    m.logo.uri = logoUrl
    ' Properties without a logo show their name instead.
    if logoUrl = ""
        title = property.title
        m.logoText.text = strNotEmpty(title) ? title : (property.name ?? "")
    else
        m.logoText.text = ""
    end if

    m.heroDescription.text = property.main_page_description ?? ""
end sub

' Shrink the logo to the bitmap's real width, or a narrow logo ends up centered
' inside its max-width box instead of left-aligned.
sub onLogoLoaded()
    if m.logo.loadStatus = "ready" and m.logo.width > m.logo.bitmapWidth
        m.logo.width = m.logo.bitmapWidth
    end if
end sub

sub onPropertySelected()
    property = propertyAt(m.rowList.rowItemSelected)
    if property = invalid
        Toast.show("Error loading property")
        return
    end if

    skipLogin = property?.login?.settings?.disable_login = true
    loginProvider = SignInUtil.getLoginProvider(property)
    if skipLogin or (stores.tokenStore().loginProvider = loginProvider)
        view = CreateObject("roSGNode", "PropertyDetail")
        view.property = property
        router()@.show({ view: view })
    else
        if loginProvider = "ory"
            signIn = CreateObject("roSGNode", "SignInSelector")
        else
            ' Don't offer manual sign-in for auth0
            signIn = CreateObject("roSGNode", "QrSignIn")
        end if
        signIn.property = property
        router().addStack = "signin"
        router()@.show({ view: signIn })
    end if
end sub

' [index] is a [rowIndex, itemIndex] pair, as reported by the RowList.
function propertyAt(index)
    if index.count() < 2 then return invalid
    return m.rowList.content?.getChild(index[0])?.getChild(index[1])?.aa
end function
